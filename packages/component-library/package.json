{
  "name": "@mapletip/component-library",
  "version": "0.0.0",
  "private": true,
  "sideEffects": [
    "**/*.css"
  ],
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./styles.css": "./dist/styles.css"
  },
  "types": "./dist/index.d.ts",
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "vite build --config vite.lib.config.ts",
    "build-storybook": "storybook build -o storybook-static --quiet",
    "dev": "vite build --watch --config vite.lib.config.ts",
    "lint": "eslint . --max-warnings 0",
    "storybook": "storybook dev -p 6006 --host localhost --ci --no-open",
    "test": "vitest run --project '!visual'",
    "test:visual": "vitest run --project visual --update=none",
    "test:watch": "vitest --project '!visual'",
    "typecheck": "tsc"
  },
  "dependencies": {
    "@mantine/core": "catalog:",
    "@mantine/hooks": "catalog:",
    "@mapletip/theme": "workspace:*",
    "@phosphor-icons/react": "catalog:",
    "@tanstack/react-table": "catalog:",
    "@tanstack/table-core": "catalog:",
    "mantine-datatable": "catalog:"
  },
  "devDependencies": {
    "@mapletip/config": "workspace:*",
    "@storybook/addon-a11y": "catalog:",
    "@storybook/addon-vitest": "catalog:",
    "@storybook/react-vite": "catalog:",
    "@testing-library/jest-dom": "catalog:",
    "@testing-library/react": "catalog:",
    "@testing-library/user-event": "catalog:",
    "@types/node": "catalog:",
    "@types/react": "catalog:",
    "@types/react-dom": "catalog:",
    "@vitejs/plugin-react": "catalog:",
    "@vitest/browser-playwright": "catalog:",
    "eslint": "catalog:",
    "jsdom": "catalog:",
    "playwright": "catalog:",
    "postcss": "catalog:",
    "postcss-preset-mantine": "catalog:",
    "postcss-simple-vars": "catalog:",
    "react": "catalog:",
    "react-dom": "catalog:",
    "storybook": "catalog:",
    "typescript": "catalog:",
    "vite": "catalog:",
    "vitest": "catalog:",
    "vitest-browser-react": "catalog:"
  },
  "peerDependencies": {
    "react": "^19.2.0",
    "react-dom": "^19.2.0"
  }
}
