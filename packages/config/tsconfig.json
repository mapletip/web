{
  "compilerOptions": {
    "allowJs": true,
    "checkJs": true,
    "noEmit": true,
    "strict": true,
    "module": "nodenext",
    "moduleResolution": "nodenext",
    "target": "es2023",
    "types": ["node"],
    "skipLibCheck": true
  },
  "include": ["eslint", "prettier", "lint-staged", "vitest", "vite", "scripts"]
}
