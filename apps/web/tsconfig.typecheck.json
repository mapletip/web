{
  "extends": "./tsconfig.json",
  "include": ["src", "vite.config.ts"],
  "compilerOptions": {
    "paths": {
      "#/*": ["./src/*"],
      "@/components/*": ["../../packages/component-library/src/components/*"],
      "@/fixtures/*": ["../../packages/component-library/src/fixtures/*"],
      "@/test-support/*": [
        "../../packages/component-library/src/test-support/*"
      ],
      "@/*": ["./src/*"]
    }
  }
}
