{
  "extends": "@mapletip/config/typescript/vite-react",
  "include": ["src", "vite.config.ts"],
  "compilerOptions": {
    "allowImportingTsExtensions": true,
    "paths": {
      "#/*": ["./src/*"],
      "@/components/*": ["../../packages/component-library/src/components/*"],
      "@/fixtures/*": ["../../packages/component-library/src/fixtures/*"],
      "@/test-support/*": [
        "../../packages/component-library/src/test-support/*"
      ],
      "@/*": ["./src/*"]
    },
    "types": ["vite/client", "node"],
    "verbatimModuleSyntax": true
  }
}
