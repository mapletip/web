{
  "extends": "@mapletip/config/typescript/vite-react",
  "include": ["src", "vite.config.ts"],
  "compilerOptions": {
    "allowImportingTsExtensions": true,
    "paths": {
      "#/*": ["./src/*"],
      "@/*": ["./src/*"]
    },
    "types": ["vite/client", "node"],
    "verbatimModuleSyntax": true
  }
}
