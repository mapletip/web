{
  "$schema": "https://turborepo.dev/schema.json",
  "ui": "tui",
  "globalDependencies": [".nvmrc"],
  "tasks": {
    "//#format:check:root": {},
    "//#format:root": {
      "cache": false
    },
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**"]
    },
    "build-storybook": {
      "outputs": ["storybook-static/**"]
    },
    "lint": {
      "dependsOn": ["^lint", "^build"]
    },
    "storybook": {
      "cache": false,
      "persistent": true,
      "passThroughEnv": ["PLAYWRIGHT_BROWSERS_PATH", "PLAYWRIGHT_WS_ENDPOINT"]
    },
    "test": {
      "dependsOn": ["^build"],
      "passThroughEnv": ["PLAYWRIGHT_BROWSERS_PATH", "PLAYWRIGHT_WS_ENDPOINT"]
    },
    "typecheck": {
      "dependsOn": ["^typecheck", "^build"]
    },
    "dev": {
      "cache": false,
      "persistent": true
    },
    "dev:app": {
      "cache": false,
      "persistent": true,
      "dependsOn": ["^build"],
      "with": ["@mapletip/component-library#dev"]
    }
  }
}
